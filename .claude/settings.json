{
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep",
      "Bash(node:*)", "Bash(npm:*)", "Bash(npx playwright:*)",
      "Bash(git status:*)", "Bash(git add:*)", "Bash(git commit:*)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(git tag:*)", "Bash(git push:*)", "Bash(git stash:*)", "Bash(git branch:*)", "Bash(git checkout:*)", "Bash(git restore:*)", "Bash(git rev-parse:*)",
      "Bash(gh run:*)", "Bash(gh api repos/EitanPinczowski/what_to_eat/*)",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(sed:*)", "Bash(grep:*)", "Bash(find:*)", "Bash(mkdir:*)", "Bash(cp:*)", "Bash(mv:*)", "Bash(date:*)", "Bash(wc:*)", "Bash(export PATH=*)", "Bash(cd:*)",
      "PowerShell(node:*)", "PowerShell(npm:*)", "PowerShell(npx playwright:*)", "PowerShell(git status:*)", "PowerShell(git add:*)", "PowerShell(git commit:*)", "PowerShell(git push:*)", "PowerShell(git tag:*)",
      "mcp__ccd_session_mgmt__get_usage", "mcp__ccd_session_mgmt__list_sessions",
      "mcp__Claude_Browser", "PushNotification",
      "mcp__scheduled-tasks__update_scheduled_task", "mcp__scheduled-tasks__list_scheduled_tasks"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git reset --hard:*)", "Bash(git clean:*)",
      "PowerShell(git push --force:*)", "PowerShell(git reset --hard:*)", "PowerShell(git clean:*)"
    ]
  }
}
