rules_version = '2';

// Everything lives under rooms/{roomId}. The room id is a long random string
// that only travels inside the links the owner sends, so holding the id is
// what grants access. Nobody can list rooms, so ids cannot be discovered.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function smallDoc() {
      return request.resource.data.keys().size() <= 60;
    }

    // String-length caps for guest-written fields (spec §2.2). Matches the cuts in js/ui/guest/session.js.
    function cap(f, n) {
      let d = request.resource.data;
      return !(f in d) || !(d[f] is string) || d[f].size() <= n;
    }

    function capped() {
      return cap('fn', 80) && cap('fe', 32) && cap('note', 300) && cap('text', 500)
        && cap('msg', 300) && cap('recipe', 80) && cap('stack', 1500) && cap('screen', 40) && cap('ua', 200);
    }

    match /rooms/{roomId} {
      allow get: if signedIn();
      allow create, update: if signedIn() && roomId.size() >= 20 && smallDoc();
      allow list, delete: if false;

      match /{col}/{docId} {
        allow read: if signedIn()
          && col in ['history', 'places', 'live', 'feedback', 'errors', 'shopping'];
        allow create, update: if signedIn()
          && col in ['history', 'places', 'live', 'feedback', 'errors', 'shopping']
          && smallDoc() && capped();
        allow delete: if signedIn()
          && col in ['history', 'places', 'live', 'shopping'];
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
